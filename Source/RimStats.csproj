<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    
    <!-- Define base paths for build organization relative to the project directory -->
    <ModDir>$(ProjectDir)../Mod</ModDir>
    <AssembliesPath>$(ProjectDir)../Mod/Assemblies</AssembliesPath>
    
    <!-- Output directory dynamically set based on build configuration (Debug/Release) -->
    <OutputPath>$(ProjectDir)../Builds/$(Configuration)</OutputPath>
    <BinPath>$(ModDir)/Bin</BinPath>

    <!-- Ensure NuGet dependencies are copied locally -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- References to local game engine libraries (not copied to output) -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(AssembliesPath)/Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(AssembliesPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(AssembliesPath)/0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    
    <!-- NuGet package for SQLite database support -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="6.0.0" />
  </ItemGroup>
  
</Project>