# .NET / C# Build Artifacts
# Ignore temporary build files generated by MSBuild/dotnet
[Oo]bj/

# User-specific project settings
*.user
*.userosscache
*.sln.docstates
*.suo

# RimWorld Modding Specifics
# Ignore only your compiled mod assembly and debug symbols.
# We keep third-party dependencies (like Microsoft.Data.Sqlite.dll) 
# unless you prefer to restore them via NuGet every time.
Mod/Assemblies/RimStats.dll
Mod/Assemblies/RimStats.pdb

# Ignore the runtime native libraries folder copied during build
Mod/Assemblies/runtimes

# Ignore log files generated by the game during testing
*.log
*.UnityUI

# SQLite Database Files
# Prevent personal analytics data and lock files from being committed
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# IDE & OS Junk
# Visual Studio Code settings
.vscode/
.ionide/

# JetBrains IDEs
.idea/

# OS-specific files
.DS_Store
Thumbs.db

# Python (if used for automation scripts)
__pycache__/
*.py[cod]
.venv/
venv/